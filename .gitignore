# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- uv / venv ---
# a symlink to an ext4 directory (see README, Environment); no trailing slash so
# the ignore rule matches a symlink as well as a directory
.venv

# --- data & artifacts live on ext4 via symlink; never commit them ---
/data
/outputs

# --- local env overrides ---
.env.local

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# unsloth writes compiled trainer code to the working directory unless
# UNSLOTH_COMPILE_LOCATION is set (the training script sets it)
unsloth_compiled_cache/
